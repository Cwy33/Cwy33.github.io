/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Page background */
body {
    background-color: #417589;
    font-family: Arial, sans-serif;
}

/* Header */
header {
    background-color: #163b50;
    color: white;
    text-align: center;
    padding: 25px;
}

/* Navigation */
nav {
    background-color: white;
    padding: 15px;
}

nav ul {
    list-style-type: none;
    text-align: center;
}

nav li {
    display: inline-block;
    margin: 10px;
}

nav a {
    color: #163b50;
    text-decoration: none;
}

nav a:hover {
    color: teal;
}

/* Main content */
main {
    background-color: white;
    margin: 20px auto;
    padding: 20px;
    max-width: 1000px;
}

h2 {
    margin-bottom: 10px;
}

p {
    margin-bottom: 15px;
}

/* Images */
img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* Footer */
footer {
    color: white;
    text-align: center;
    padding: 20px;
}
